{
  "name": "codebase-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive learning map for an analyzed codebase (architecture, lineage, docs, code browser).",
  "scripts": {
    "data": "node scripts/data.mjs",
    "predev": "npm run data",
    "dev": "vite",
    "prebuild": "npm run data",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "marked": "^12.0.2",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
